# Copy to .env. Never commit .env.
GEMINI_API_KEY=
# Used only to register with the Gemini Credentials API for the Approve flow; never sent to the model.
GITHUB_TOKEN=
# PRs go only to forks owned by this account.
JATAYU_FORK_OWNER=
JATAYU_TARGET_DJANGO=5.2.18
JATAYU_BASELINE_DJANGO=4.2.30
JATAYU_MAX_ITERATIONS=4
JATAYU_MAX_OUTPUT_TOKENS=262144

# Write actions on the shared Runs + Fleet server. Unset = read-only.
JATAYU_DASHBOARD_TOKEN=
